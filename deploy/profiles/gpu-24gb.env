# ---- Profile gpu-24gb: RTX 3090 / 4090 / L4 / A5000 and up ---------------------
# VRAM budget (24 GB): encoders ~3.5 GB; vLLM 0.75 x 24 = 18 GB: Qwen3-14B AWQ weights
# ~9.9 GB, graphs+activations ~1.5 GB, KV ~6.5 GB (~40k tokens fp16, ~80k fp8).
SMRITI_PROFILE=gpu-24gb
COMPOSE_PROFILES=llm,gpu-encoders
LLM_MODEL=Qwen/Qwen3-14B-AWQ
LLM_GPU_MEMORY_UTILIZATION=0.75
LLM_MAX_MODEL_LEN=16384
LLM_MAX_NUM_SEQS=32
LLM_KV_CACHE_DTYPE=fp8
LLM_ENFORCE_EAGER=0
SMRITI_CHAT_CONCURRENCY=16
SMRITI_WORKERS=4
EMBED_MAX_BATCH_TOKENS=16384
RERANK_MAX_BATCH_TOKENS=16384
