# ---- Profile gpu-6gb: laptops and small cards (RTX 4050/3050/2060 6-8 GB) -------
# The GPU runs only the LLM; the embedder runs on the CPU and reranking uses the
# built-in lexical reranker (a cross-encoder on CPU would cost ~1-3 s per query).
# vLLM 0.80 x 6 GB = 4.8 GB: Qwen3-4B AWQ 2.7 GB, eager mode (no CUDA graphs) ~0.5 GB,
# KV ~1.5 GB = ~10k tokens = 4 chats at ~2.5k tokens.
SMRITI_PROFILE=gpu-6gb
COMPOSE_PROFILES=llm,cpu-encoders
LLM_MODEL=Qwen/Qwen3-4B-AWQ
LLM_GPU_MEMORY_UTILIZATION=0.80
LLM_MAX_MODEL_LEN=4096
LLM_MAX_NUM_SEQS=4
LLM_MAX_NUM_BATCHED_TOKENS=2048
LLM_KV_CACHE_DTYPE=auto
LLM_ENFORCE_EAGER=1
SMRITI_CHAT_CONCURRENCY=2
SMRITI_CONTEXT_TOKENS=1200
EMBED_MAX_BATCH_TOKENS=4096
RERANK_MAX_BATCH_TOKENS=4096
# CPU encoder: multilingual-e5-small (118M params, MIT, Hindi included) ships ONNX, so TEI runs
# its ONNX Runtime backend. Measured on a 16-core laptop: 8-17 ms per query vs ~300 ms for
# Qwen3-Embedding-0.6B (no ONNX export, so TEI falls back to its slower Candle backend on CPU).
EMBED_MODEL=intfloat/multilingual-e5-small
SMRITI_EMBED_MODEL=intfloat/multilingual-e5-small
SMRITI_EMBED_QUERY_PREFIX="query: "
SMRITI_EMBED_DOC_PREFIX="passage: "
SMRITI_RERANK_URL=
