# ---- Profile gpu-6gb: laptops and small cards (RTX 4050/3050/2060 6-8 GB) -------
# The GPU runs only the LLM; the embedder runs on the CPU and reranking uses the
# built-in lexical reranker (a cross-encoder on CPU would cost ~1-3 s per query).
#
# LLM: llama.cpp (`llm-gguf`) with Qwen3-4B Q4_K_M and an 8-bit KV cache.
# Measured on an RTX 4050 Laptop 6 GB (docs/model-benchmarks.md):
#   VRAM ~4.6 GB including ~0.7 GB the desktop holds; 53 tokens/s for one user;
#   1,000-token prompts keep 4 concurrent chats within TTFT <= 2 s and TPOT <= 100 ms,
#   1,500-token prompts only 2, so context stays at 1,000 tokens and concurrency at 4.
#   The f16 KV cache was slower (83 vs 104 tokens/s at 8 streams) and used 1 GB more.
# Why not vLLM here: its image is ~20 GB unpacked, and on 6 GB it needs eager mode and
# leaves ~1.5 GB for the KV cache. To use it anyway: COMPOSE_PROFILES=llm,cpu-encoders
# and LLM_MODEL=Qwen/Qwen3-4B-AWQ, LLM_GPU_MEMORY_UTILIZATION=0.80, LLM_MAX_MODEL_LEN=4096,
# LLM_MAX_NUM_BATCHED_TOKENS=2048, LLM_ENFORCE_EAGER=1.
SMRITI_PROFILE=gpu-6gb
COMPOSE_PROFILES=llm-gguf,cpu-encoders
# weights: deploy/bench/get-gguf.sh 4b (the installer runs it), into the model cache
GGUF_MODEL=Qwen3-4B-Q4_K_M.gguf
GGUF_KV_TYPE=q8_0
# total tokens across all slots: 4 x 3,072 (1,000 context + rules + question + 512 answer)
GGUF_CTX=12288
LLM_MAX_NUM_SEQS=4
SMRITI_CHAT_CONCURRENCY=4
SMRITI_CONTEXT_TOKENS=1000
EMBED_MAX_BATCH_TOKENS=4096
RERANK_MAX_BATCH_TOKENS=4096
# CPU encoder: multilingual-e5-small (118M params, MIT, Hindi included) ships ONNX, so TEI runs
# its ONNX Runtime backend. Measured on a 16-core laptop: 8-17 ms per query vs ~300 ms for
# Qwen3-Embedding-0.6B (no ONNX export, so TEI falls back to its slower Candle backend on CPU).
EMBED_MODEL=intfloat/multilingual-e5-small
SMRITI_EMBED_MODEL=intfloat/multilingual-e5-small
SMRITI_EMBED_QUERY_PREFIX="query: "
SMRITI_EMBED_DOC_PREFIX="passage: "
SMRITI_RERANK_URL=
