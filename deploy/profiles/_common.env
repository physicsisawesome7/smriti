# ---- Smriti deployment settings (shared by every profile) -------------------
# The installer writes .env = this file + the chosen profile + detected values.
# Edit .env afterwards and run `docker compose up -d` to apply.

# Web app / API
SMRITI_PORT=8000
# 127.0.0.1 keeps it on this machine; set 0.0.0.0 to serve the LAN (put TLS in front)
SMRITI_BIND=127.0.0.1
# demo: pick a person in the UI. token: SMRITI_API_TOKENS=token1:user1,token2:user2
SMRITI_AUTH=demo
# your own tenant pack: put it under ./packs and point here, e.g. /app/packs/tenants/acme
SMRITI_PACKS=/app/packs/tenants/railways-demo
SMRITI_WORKERS=2
# wait this long for model servers on first start (downloads)
SMRITI_MODEL_WAIT_S=1800

# Model routes seen by Smriti (services on the compose network)
SMRITI_EMBED_URL=http://embed:80/v1
SMRITI_RERANK_URL=http://rerank:80
SMRITI_CHAT_URL=http://llm:8000/v1
SMRITI_CHAT_MODEL=smriti-chat
# Qwen3 is a hybrid reasoning model; thinking tokens cost GPU time and are never shown
SMRITI_CHAT_EXTRA={"chat_template_kwargs":{"enable_thinking":false}}
SMRITI_CHAT_MAX_TOKENS=512
SMRITI_CONTEXT_TOKENS=1800

# Encoders (TEI)
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
RERANK_MODEL=BAAI/bge-reranker-v2-m3
SMRITI_EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
SMRITI_RERANK_MODEL=BAAI/bge-reranker-v2-m3

# LLM (vLLM)
LLM_SERVED_NAME=smriti-chat
LLM_QUANTIZATION=awq_marlin
LLM_MAX_NUM_BATCHED_TOKENS=4096
LLM_SPECULATIVE=none
LLM_EXTRA_ARGS=

# Gated models only; leave empty for the defaults (all Apache-2.0, ungated)
HF_TOKEN=

# 1 after the first online start: never contact Hugging Face again (air-gapped)
HF_HUB_OFFLINE=0
