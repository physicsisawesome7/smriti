# ---- Profile gpu-16gb: RTX 5070 Ti / 5080 / 4080 / 4060 Ti 16 GB class --------
# VRAM budget (16 GB):
#   desktop/display reserve        ~0.6 GB
#   embed + rerank (TEI, fp16)     ~3.5 GB
#   vLLM   0.70 x 16 GB = ~11.2 GB Qwen3-8B AWQ weights 6.1, graphs+activations ~1.2,
#                                  KV cache ~3.9 GB. With FP8 KV (Ada/Blackwell) that is
#                                  ~53k tokens (74 KB/token) = 16 chats at ~3k tokens.
# On an Ampere 16 GB card (A4000, RTX 3080 Ti laptop) set LLM_KV_CACHE_DTYPE=auto.
# RTX 50-series: if vLLM fails with "no kernel image is available", use NVIDIA's build:
#   VLLM_IMAGE=nvcr.io/nvidia/vllm:<latest>-py3   (see deploy/README.md)
SMRITI_PROFILE=gpu-16gb
COMPOSE_PROFILES=llm,gpu-encoders
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_GPU_MEMORY_UTILIZATION=0.70
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=16
LLM_KV_CACHE_DTYPE=fp8
LLM_ENFORCE_EAGER=0
SMRITI_CHAT_CONCURRENCY=8
EMBED_MAX_BATCH_TOKENS=8192
RERANK_MAX_BATCH_TOKENS=8192
