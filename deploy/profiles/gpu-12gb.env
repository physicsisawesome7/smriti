# ---- Profile gpu-12gb: RTX 3060 12 GB, RTX 4070, RTX 2080 Ti class -------------
# VRAM budget (12 GB):
#   desktop/display reserve        ~0.6 GB
#   embed  Qwen3-Embedding-0.6B    ~1.8 GB  (fp16 weights 1.2 + CUDA context + batch)
#   rerank bge-reranker-v2-m3      ~1.7 GB  (fp16 weights 1.1 + CUDA context + batch)
#   vLLM   0.58 x 12 GB = ~7.0 GB  Qwen3-4B AWQ weights 2.7, graphs+activations ~1.0,
#                                  KV cache ~3.3 GB = ~22k tokens (147 KB/token at fp16)
# -> 16 concurrent chats at ~1.4k tokens each. Ampere has no FP8 KV cache path we trust,
#    so KV stays fp16. For better drafting quality at lower concurrency, switch to
#    LLM_MODEL=Qwen/Qwen3-8B-AWQ, LLM_GPU_MEMORY_UTILIZATION=0.62, LLM_MAX_NUM_SEQS=4,
#    LLM_MAX_MODEL_LEN=6144 (KV ~0.9 GB, about 6k tokens in flight).
SMRITI_PROFILE=gpu-12gb
COMPOSE_PROFILES=llm,gpu-encoders
LLM_MODEL=Qwen/Qwen3-4B-AWQ
LLM_GPU_MEMORY_UTILIZATION=0.58
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=16
LLM_KV_CACHE_DTYPE=auto
LLM_ENFORCE_EAGER=0
SMRITI_CHAT_CONCURRENCY=8
EMBED_MAX_BATCH_TOKENS=8192
RERANK_MAX_BATCH_TOKENS=8192
